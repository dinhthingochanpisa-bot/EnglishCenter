# Public URLs/ports on the Docker server
WEB_HOST_PORT=8445
API_HOST_PORT=8446
POSTGRES_HOST_PORT=3002
FRONTEND_URL=http://localhost:8445
NEXT_PUBLIC_API_URL=http://localhost:8446

# Images loaded on the server
WEB_IMAGE=english-center-web:latest
API_IMAGE=english-center-api:latest

# Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=english_center_db

# Auth
JWT_SECRET=change-this-jwt-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Files
UPLOAD_DIR=uploads/branding
