# Infrastructure
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=english_center_db
DATABASE_URL="postgresql://admin:password@localhost:5432/english_center_db?schema=public"

# Auth
JWT_SECRET=supersecret
JWT_REFRESH_SECRET=superrefreshsecret
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
NODE_ENV=development

# Apps
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_REFRESH_MS=30000
API_SERVER_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
UPLOAD_DIR=uploads/logo

# Smoke test (optional)
SMOKE_API_URL=http://127.0.0.1:3000
SMOKE_LOGIN_EMAIL=superadmin@example.com
SMOKE_LOGIN_PASSWORD=password123
SMOKE_CENTER_CODE=CN01
SMOKE_OUTSIDER_CENTER_CODE=CN02
SMOKE_CLASS_CODE=CLS-CN01-001
SMOKE_STUDENT_CODE=HV-PH5-001
SMOKE_OUTSIDER_STUDENT_CODE=HV-P6-K2
